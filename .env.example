# Copy this file to `.env` (gitignored) and adjust for your local environment.
# Production deployments should provide these via the orchestrator
# (Kubernetes ConfigMap/Secret, Docker --env-file, systemd EnvironmentFile, etc.)
# rather than committing a real .env file.

# ---------- Required ----------

DATABASE_URL=postgres://webhookd:webhookd@localhost:5432/webhookd?sslmode=disable

# ---------- Kafka ----------

KAFKA_BROKERS=localhost:9092
KAFKA_DELIVERY_TOPIC=webhook.deliveries
KAFKA_CONSUMER_GROUP=webhook-workers

# ---------- Ports ----------

API_PORT=8080
METRICS_PORT=9090

# ---------- Scheduler / reaper ----------

SCHEDULER_TICK_MS=500
IN_FLIGHT_LEASE_SECONDS=300
REAPER_TICK_SECONDS=60

# ---------- Worker ----------

WORKER_CONCURRENCY=64
WORKER_HTTP_TIMEOUT_SECONDS=30

# ---------- Database pool ----------
# Role-specific defaults apply when unset (api=50, worker=20, scheduler=5).
# Set explicitly only when tuning.
# DATABASE_POOL_MAX=20

# ---------- Logging ----------

LOG_LEVEL=info
LOG_FORMAT=json
